# Copy to .env.local and fill in. Never commit real values.

# The Claude API key, for live triage (POST /api/triage) and `pnpm record`.
ANTHROPIC_API_KEY=

# Live triage. LIVE_TRIAGE=off switches it off (503 unavailable).
LIVE_TRIAGE=
# Triages per visitor per UTC day (default 5).
LIVE_TRIAGE_PER_VISITOR=
# Daily spend cap in US dollars, across all visitors (default 2).
LIVE_TRIAGE_DAILY_CAP_USD=
# Signs the visitor cookie and keys the IP hash. Required in production;
# any long random string (e.g. `openssl rand -base64 32`).
LIVE_TRIAGE_SECRET=

# The counters' store, Upstash Redis. Either pair works; Vercel's Upstash
# integration adds the KV_ pair. Without them, development uses an
# in-memory store and production refuses live triage (503).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Fake mode, for building without spending: TRIAGE_FAKE=1 answers from the
# recordings after a pause ("thanks" in the message answers "not a
# request"); the limits still count. TRIAGE_FAKE_DELAY_MS sets the pause
# (default 3500). TRIAGE_FAKE_ERROR=model, visitor-limit or daily-cap
# forces that error.
TRIAGE_FAKE=
TRIAGE_FAKE_DELAY_MS=
TRIAGE_FAKE_ERROR=
